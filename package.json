{
  "name": "resone",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio site for Résone, a textile-art studio in Abidjan",
  "scripts": {
    "sizes": "node scripts/sizes.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/sizes.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20 <27"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3"
  }
}
